<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            IMPORTANTE — force="true" aquí NO es suficiente por sí solo:
            docker-compose.yml define DB_CONNECTION/DB_DATABASE como variables
            de entorno REALES del contenedor "backend", que ya pueblan
            $_SERVER/$_ENV cuando PHP arranca. Laravel (vía phpdotenv)
            prioriza $_SERVER/$_ENV sobre el putenv() que aplica este
            force="true", así que estos <env> NO alcanzan a sobreescribir esa
            variable ya presente — sin más, los tests correrían silenciosamente
            contra sga_db (la BD real) y RefreshDatabase la vaciaría en cada test.

            La forma confiable de forzar la BD de test es exportar estas
            variables ANTES de que el proceso de PHP arranque — eso es lo que
            hace backend/scripts/test.sh. SIEMPRE correr los tests con
            `composer test` (que invoca ese script), nunca `php artisan test`
            directamente en este proyecto. Estos <env> quedan como respaldo
            para el caso de correr phpunit fuera de este contenedor Docker.
        -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_HOST" value="db" force="true"/>
        <env name="DB_PORT" value="5432" force="true"/>
        <env name="DB_DATABASE" value="sga_test" force="true"/>
        <env name="DB_USERNAME" value="sga_user" force="true"/>
        <env name="DB_PASSWORD" value="sga_secret" force="true"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
