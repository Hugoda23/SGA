# ============================================================
# Variables de entorno — PRODUCCIÓN para SGA
# Copiar como .env.production en el VPS y completar los valores reales.
# NUNCA subir el archivo .env.production real a git.
# ============================================================

# ---- Aplicación ----
APP_NAME="Instituto Florencio Carrascoza"
APP_ENV=production
APP_DEBUG=false
# Generar con: docker compose -f docker-compose.prod.yml exec backend php artisan key:generate --show
APP_KEY=
APP_URL=https://tudominio.com
LOG_LEVEL=warning

# ---- Base de datos PostgreSQL ----
DB_DATABASE=sga_db
DB_USERNAME=sga_user
# Contraseña fuerte y única para producción — no reutilizar la de desarrollo.
DB_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_FUERTE

# ---- CORS / Sanctum — dominio real del frontend en producción ----
CORS_ALLOWED_ORIGINS=https://tudominio.com
SANCTUM_STATEFUL_DOMAINS=tudominio.com
# 43200 min = 30 días. El middleware refresh.token renueva el token a mitad
# de este período mientras el usuario esté activo (sesión persistente).
SANCTUM_EXPIRATION=43200

# ---- Notificaciones push (Web Push / VAPID) ----
# Generar con: docker compose -f docker-compose.prod.yml exec backend php artisan webpush:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://tudominio.com

# ---- Frontend (React + Vite) ----
VITE_API_URL=https://tudominio.com/api
VITE_VAPID_PUBLIC_KEY=
